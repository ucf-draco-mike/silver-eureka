<section class="section" aria-labelledby="equip-h">
  <h2 id="equip-h">{{ copy.equipmentHeading }}</h2>

  {%- if site.sections.scopeNote %}
  <div class="prose note-scope">{{ copy.equipmentNoteHtml | safe }}</div>
  {%- endif %}

  <p class="prose pick-hint" id="pick-hint">{{ copy.equipmentPickHint }}</p>

  {%- if site.sections.progressCount and equipment.stats.covered > 0 %}
  <p class="progress" role="status">
    {{ equipment.stats.covered }} of {{ equipment.stats.total }}
    {{ equipment.stats.total | pluralize("instrument") }} spoken for.
    {{ equipment.stats.needed }} still {{ equipment.stats.needed | pluralize("needs", "need") }} a lender.
  </p>
  {%- endif %}

  {%- for group in equipment.groups %}
  <h3 class="prio-label" id="prio-{{ group.priority }}">{{ copy.priorityLabels[group.priority] }}</h3>
  <ul class="checklist" aria-labelledby="prio-{{ group.priority }}">
    {%- for item in group.items %}
    <li class="check-item{% if item.isSecured %} is-secured{% endif %}" id="item-{{ item.id }}">
      {#
        The checkbox IS the selection — no script involved. `form="offer-form"` makes
        it a member of the form further down the page, so a row ticked here submits
        with everything else even when JavaScript never runs. The label covers the
        whole row face, which is what makes "click the row" work natively.
      #}
      {%- if not item.isSecured %}
      <input class="card-check" type="checkbox" id="pick-{{ item.id }}"
             name="equipment" value="{{ item.name }}" form="offer-form"
             aria-describedby="pick-hint">
      <label class="check-face" for="pick-{{ item.id }}">
        <span class="check-box" aria-hidden="true"></span>
        <span class="check-text">
          <span class="check-name">{{ item.name }}<span class="badge {{ item.status }}">{{ item.status }}</span></span>
          <span class="meta">Qty {{ item.qty }} · ~{{ item.weeks_needed }} wk</span>
        </span>
      </label>
      {%- else %}
      <div class="check-face check-face-static">
        <span class="check-box check-box-static" aria-hidden="true"></span>
        <span class="check-text">
          <span class="check-name">{{ item.name }}<span class="badge {{ item.status }}">{{ item.status }}</span></span>
          <span class="meta">Qty {{ item.qty }} · ~{{ item.weeks_needed }} wk</span>
        </span>
      </div>
      {%- endif %}

      {# Kept, not cut: the compliance limits and near-equivalents are the details
         that decide whether someone's unit is usable. Folded away, not deleted. #}
      <details class="card-more">
        <summary>Details</summary>
        <div class="card-more-body">
          <p class="meta model">{{ item.examples }}</p>
          {%- if item.alternatives %}
          <p><strong>Close counts:</strong> {{ item.alternatives }}</p>
          {%- endif %}
          {%- if item.notes %}
          <p>{{ item.notes }}</p>
          {%- endif %}
        </div>
      </details>
    </li>
    {%- endfor %}
  </ul>
  {%- endfor %}

  <p class="to-form">
    <a class="offer-btn" href="#form-h">{{ copy.equipmentToFormLink }}<span aria-hidden="true"> →</span></a>
  </p>
</section>
