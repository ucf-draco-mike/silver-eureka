<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- if site.noindex %}
<meta name="robots" content="noindex">
{%- endif %}
<meta name="description" content="{{ copy.subhead }}">
<meta name="color-scheme" content="light dark">
<title>{{ copy.pageTitle }}</title>
{#- Inline so the browser's automatic /favicon.ico request never fires and 404s. #}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23161512'/%3E%3Cpath d='M6 21h4l3-9 3 14 3-11 2 6h5' fill='none' stroke='%23FFC904' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<link rel="stylesheet" href="assets/css/site.css?v={{ assets.css }}">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{{ content | safe }}
<script src="assets/js/site.js?v={{ assets.js }}" defer></script>
</body>
</html>
